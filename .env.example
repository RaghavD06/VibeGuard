# PostgreSQL connection for the API. Use a separate database for tests.
DATABASE_URL="postgresql://vibeguard:replace-with-local-password@localhost:5432/vibeguard?schema=public"
TEST_DATABASE_URL="postgresql://vibeguard:replace-with-local-password@localhost:5432/vibeguard_test"
# Docker Compose requires a locally generated password (URL-encode reserved characters in DATABASE_URL).
POSTGRES_PASSWORD="replace-with-local-password"
# Required in production. Generate a unique random value and keep it server-side.
JWT_SECRET="replace-with-a-long-random-secret"
# Comma-separated browser origins allowed to call the API in production.
CORS_ORIGIN="http://localhost:5173"
# Public browser-side API address. Never put credentials in VITE_ variables.
VITE_API_URL="http://localhost:3001"

# Optional advisory AI remediation on the API or local CLI.
NVIDIA_API_KEY="your-nvidia-nim-key"

PORT=3001
NODE_ENV=development
