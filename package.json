{
  "name": "vibeguard-monorepo",
  "version": "1.0.0",
  "description": "VibeGuard - Security for the AI-Built Software Era",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "scanners/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspace=packages/types && npm run build --workspace=packages/security-engine && npm run build --workspace=packages/ai-engine && npm run build --workspaces --if-present",
    "start": "npm run start --workspace=apps/api",
    "dev": "npm run dev --workspaces --if-present"
  },
  "dependencies": {
    "typescript": "^5.0.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.2.5",
    "@rolldown/binding-linux-x64-musl": "1.2.5",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "@tailwindcss/oxide-linux-x64-musl": "4.3.3",
    "lightningcss-linux-x64-gnu": "1.32.0",
    "lightningcss-linux-x64-musl": "1.32.0"
  }
}