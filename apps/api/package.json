{
  "name": "@maverick006/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "npm run build --workspace=@maverick006/types && npm run build --workspace=@maverick006/security-engine && npm run build --workspace=@maverick006/ai-engine",
    "build": "prisma generate && tsc",
    "start": "prisma migrate deploy && node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "clean": "rm -rf dist",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@maverick006/ai-engine": "*",
    "@maverick006/security-engine": "*",
    "@maverick006/types": "*",
    "@prisma/client": "^5.10.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "prisma": "^5.10.0",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "ts-node-dev": "^2.0.0"
  }
}
